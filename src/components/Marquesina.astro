---
// Franja lima que se desplaza en horizontal. Con movimiento reducido, se queda quieta.
import { marquesina } from '../data/home';
---

<div class="marquesina" role="region" aria-label="Lo esencial">
  <button class="marquesina__pausa" type="button" aria-pressed="false">
    <span class="solo-lector">Pausar el movimiento</span>
    <svg class="ico-pausa" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2v10M10 2v10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
    <svg class="ico-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5l9 5.5-9 5.5z" fill="currentColor" /></svg>
  </button>
  <div class="marquesina__pista">
    <ul class="marquesina__grupo" role="list">
      {marquesina.map((t) => <li>{t}</li>)}
    </ul>
    <!-- Copia para que el desplazamiento no tenga cortes. Los lectores de pantalla la ignoran. -->
    <ul class="marquesina__grupo" role="list" aria-hidden="true">
      {marquesina.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</div>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.marquesina__pausa');
  const franja = document.querySelector('.marquesina');
  boton?.addEventListener('click', () => {
    const pausada = boton.getAttribute('aria-pressed') !== 'true';
    boton.setAttribute('aria-pressed', String(pausada));
    franja?.classList.toggle('pausada', pausada);
    boton.querySelector('.solo-lector')!.textContent = pausada ? 'Reanudar el movimiento' : 'Pausar el movimiento';
  });
</script>

<style>
  .marquesina {
    position: relative;
    overflow: hidden;
    background: var(--lima);
    color: var(--negro);
    border-block: 2px solid var(--negro);
  }

  .marquesina__pista {
    display: flex;
    width: max-content;
  }

  .marquesina__grupo {
    display: flex;
    flex-shrink: 0;
  }

  .marquesina__grupo li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.875rem 0 0.875rem 1.25rem;
    font-weight: 900;
    font-stretch: 110%;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquesina__grupo li::after {
    content: '✦';
    font-size: 0.9em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquesina__pista {
      animation: desplazar 32s linear infinite;
    }

    .marquesina:hover .marquesina__pista,
    .marquesina.pausada .marquesina__pista {
      animation-play-state: paused;
    }
  }

  .marquesina__pausa {
    position: absolute;
    z-index: 1;
    right: 0.5rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--negro);
    color: var(--lima);
    cursor: pointer;
  }

  .marquesina__pausa:focus-visible {
    outline-color: var(--negro);
  }

  .marquesina__pausa .ico-play,
  .marquesina__pausa[aria-pressed='true'] .ico-pausa {
    display: none;
  }

  .marquesina__pausa[aria-pressed='true'] .ico-play {
    display: block;
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  /* Movimiento reducido: un solo grupo, quieto y en varias líneas si hace falta. */
  @media (prefers-reduced-motion: reduce) {
    .marquesina__pista {
      width: auto;
    }
    .marquesina__grupo {
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquesina__grupo[aria-hidden='true'],
    .marquesina__pausa {
      display: none;
    }
  }
</style>
