---
import { Picture } from 'astro:assets';
import { losDeDentro as b } from '../data/home';
const total = b.personas.length;
---

<section class="dentro bloque" aria-labelledby="dentro-titulo">
  <header class="dentro__cabecera contenedor" data-aparece>
    <div class="dentro__intro">
      <p class="etiqueta">{b.etiqueta}</p>
      <h2 id="dentro-titulo">{b.titulo}</h2>
      <p class="dentro__texto">{b.texto}</p>
    </div>

    <div class="dentro__controles">
      <button class="dentro__flecha" type="button" data-dir="-1" aria-controls="dentro-carril">
        <span class="solo-lector">Anterior</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M12.5 4.5L7 10l5.5 5.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <p class="dentro__contador" aria-live="polite">
        <span data-actual>1</span> / {total}
      </p>
      <button class="dentro__flecha" type="button" data-dir="1" aria-controls="dentro-carril">
        <span class="solo-lector">Siguiente</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </header>

  <!-- PENDIENTE: vídeos de los profesionales. Cuando existan, cada tarjeta abre su vídeo. -->
  <ul id="dentro-carril" class="dentro__carril carril" role="list" tabindex="0" aria-label="Profesionales">
    {
      b.personas.map((p) => (
        <li>
          <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
          <figure class="reel" data-placeholder={p.placeholder ? 'true' : undefined}>
            <Picture
              src={p.foto}
              formats={['avif', 'webp']}
              widths={[320, 480, 700]}
              sizes="(min-width: 64rem) 17rem, 72vw"
              alt={p.alt}
              class="reel__foto"
            />
            <span class="reel__duracion">
              <svg width="10" height="11" viewBox="0 0 10 12" aria-hidden="true"><path d="M1.2 1.2l7.6 4.8-7.6 4.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
              <span class="solo-lector">Vídeo de </span>{p.duracion}
            </span>
            <figcaption class="reel__pie">
              <blockquote class="reel__cita"><p>«{p.cita}»</p></blockquote>
              <span class="reel__nombre">{p.nombre}, {p.edad}</span>
              <span class="reel__profesion">{p.profesion}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const carril = document.getElementById('dentro-carril');
  const actual = document.querySelector('.dentro [data-actual]');
  const flechas = document.querySelectorAll<HTMLButtonElement>('.dentro__flecha');

  if (carril && actual) {
    const items = Array.from(carril.children) as HTMLElement[];

    const indice = () => {
      const izq = carril.getBoundingClientRect().left + parseFloat(getComputedStyle(carril).paddingLeft);
      let mejor = 0;
      let dist = Infinity;
      items.forEach((it, i) => {
        const d = Math.abs(it.getBoundingClientRect().left - izq);
        if (d < dist) {
          dist = d;
          mejor = i;
        }
      });
      return mejor;
    };

    const controles = document.querySelector<HTMLElement>('.dentro__controles');
    const actualizar = () => {
      // Si todos los reels caben, las flechas sobran.
      if (controles) controles.style.visibility = carril.scrollWidth > carril.clientWidth + 4 ? '' : 'hidden';
      const i = indice();
      actual.textContent = String(i + 1);
      const fin = carril.scrollLeft + carril.clientWidth >= carril.scrollWidth - 4;
      flechas.forEach((f) => {
        f.disabled = f.dataset.dir === '-1' ? carril.scrollLeft <= 4 : fin;
      });
    };

    flechas.forEach((f) =>
      f.addEventListener('click', () => {
        const destino = items[Math.min(items.length - 1, Math.max(0, indice() + Number(f.dataset.dir)))];
        const izq = parseFloat(getComputedStyle(carril).paddingLeft);
        carril.scrollTo({ left: destino.offsetLeft - izq, behavior: 'smooth' });
      })
    );

    let espera: number | undefined;
    carril.addEventListener('scroll', () => {
      clearTimeout(espera);
      espera = window.setTimeout(actualizar, 60);
    });
    window.addEventListener('resize', actualizar);
    actualizar();
  }
</script>

<style>
  .dentro {
    border-top: 1px solid var(--linea);
    overflow: hidden;
  }

  .dentro__cabecera {
    display: grid;
    gap: var(--e-3);
    margin-bottom: var(--e-4);
  }

  .dentro__intro {
    display: grid;
    gap: var(--e-2);
  }

  .dentro__intro h2 {
    font-size: var(--t-5);
    max-width: 15ch;
  }

  .dentro__texto {
    font-size: var(--t-3);
    max-width: 36rem;
    color: var(--hueso-suave);
  }

  .dentro__controles {
    display: none;
  }

  .dentro__carril {
    grid-auto-columns: min(72%, 17rem);
  }

  /* Reel vertical, el formato que este público ve cada día. La foto ocupa
     toda la tarjeta y el texto va encima, sobre un degradado. */
  .reel {
    position: relative;
    aspect-ratio: 9 / 16;
    max-height: 34rem;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    background: var(--negro-2);
  }

  .reel :global(.reel__foto),
  .reel :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .reel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: scale 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(22 20 18 / 0.35) 0%, rgb(22 20 18 / 0) 22%, rgb(22 20 18 / 0) 42%, rgb(22 20 18 / 0.92) 100%);
    pointer-events: none;
  }

  /* Icono de vídeo discreto: trazo fino junto a la duración, sin tapar la imagen. */
  .reel__duracion {
    position: absolute;
    z-index: 1;
    top: 0.875rem;
    left: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(22 20 18 / 0.55);
    border: 1px solid rgb(236 232 222 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--hueso);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .reel__pie {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem;
    color: var(--hueso);
  }

  .reel__cita {
    font-size: 1.1875rem;
    line-height: 1.15;
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }

  .reel__nombre {
    font-weight: 800;
    font-size: 1rem;
  }

  .reel__profesion {
    font-family: var(--mano);
    font-size: 1rem;
    color: var(--lima);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .reel:hover :global(img) {
      scale: 1.04;
    }
    .reel:hover .reel__duracion {
      background: var(--lima);
      border-color: var(--lima);
      color: var(--negro);
    }
  }

  @media (min-width: 48rem) {
    .dentro__cabecera {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .dentro__controles {
      display: flex;
      align-items: center;
      gap: var(--e-2);
    }

    .dentro__flecha {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1.5px solid var(--linea);
      border-radius: 999px;
      background: none;
      cursor: pointer;
      transition: border-color 150ms ease, background-color 150ms ease;
    }

    .dentro__flecha:hover:not(:disabled) {
      border-color: var(--hueso);
    }

    .dentro__flecha:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .dentro__contador {
      min-width: 3.5rem;
      text-align: center;
      font-size: var(--t-1);
      font-variant-numeric: tabular-nums;
      color: var(--hueso-suave);
    }

    /* Escritorio: el carril arranca alineado con el contenedor y sangra a la derecha. */
    .dentro__carril {
      /* Cuatro reels caben a lo ancho del contenedor en escritorio. */
      grid-auto-columns: clamp(14rem, 20vw, 17.5rem);
      gap: var(--e-3);
      padding-inline: max(var(--margen), (100% - var(--ancho)) / 2);
      scroll-padding-inline: max(var(--margen), (100% - var(--ancho)) / 2);
    }
  }
</style>
