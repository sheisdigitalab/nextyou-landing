---
// Pantalla amable que aparece al pulsar «Hacer el test»: pide el correo sin presionar.
// Principios: una sola pregunta, razones claras de para qué se usa, salida siempre visible
// (se puede seguir sin dejarlo) y cero formulario «de administración».
//
// PENDIENTE CLIENTA / DESARROLLO (no está activo hasta decidirlo):
//  - Destino real del correo (endpoint de la lista de envío) → hoy NO se guarda ni se envía en ningún sitio.
//  - Texto legal y de menores (datos de personas de 16-17 años) y enlace de baja.
//  - URL real del test: cuando exista, `DESTINO_TEST` redirige ahí tras este paso.
import { ENLACES } from '../config';

interface Props {
  /** URL del test cuando exista; mientras sea '#' se muestra la confirmación en la propia pantalla */
  destinoTest?: string;
}
const { destinoTest = '#' } = Astro.props;
---

<dialog class="correo" aria-labelledby="correo-titulo" data-destino-test={destinoTest}>
  <div class="correo__caja">
    <button type="button" class="correo__cerrar" aria-label="Cerrar" data-correo-cerrar>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>

    <!-- Paso 1: pedir el correo -->
    <div class="correo__paso" data-correo-paso="pedir">
      <p class="correo__eti">Antes de empezar</p>
      <h2 id="correo-titulo" class="correo__titulo">¿A dónde te mandamos tus resultados?</h2>
      <p class="correo__sub">Al terminar el test te enviamos tu perfil y tus 3 caminos, para que los tengas siempre a mano y puedas seguir explorando con calma.</p>

      <form class="correo__form" novalidate data-correo-form>
        <label class="correo__label" for="correo-email">Tu correo</label>
        <div class="correo__campo">
          <input id="correo-email" name="correo" type="email" inputmode="email" autocomplete="email" placeholder="nombre@correo.com" aria-describedby="correo-ayuda correo-error" />
        </div>
        <p id="correo-error" class="correo__error" role="alert" hidden></p>
        <p id="correo-ayuda" class="correo__ayuda">Solo lo usamos para eso. Sin spam, y te das de baja con un clic.</p>

        <button type="submit" class="boton boton--grande correo__enviar">
          <span class="correo__t">Empezar el test</span><span aria-hidden="true">→</span>
        </button>
        <button type="button" class="correo__saltar" data-correo-saltar>Prefiero empezar sin dejar mi correo</button>
      </form>

      <ul class="correo__confianza" role="list">
        <li>
          <span class="correo__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg></span>
          <span><strong>Solo para tus resultados</strong>y para enviarte ideas con las que explorar tu camino. Nada más.</span>
        </li>
        <li>
          <span class="correo__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></span>
          <span><strong>Nunca lo compartimos</strong>ni lo vendemos. Es tuyo.</span>
        </li>
        <li>
          <span class="correo__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <span><strong>Te vas cuando quieras</strong>con un clic desde cualquier correo que te enviemos.</span>
        </li>
      </ul>

      <p class="correo__micro">8 minutos · gratis · sin tarjeta. <a href={ENLACES.privacidad}>Cómo cuidamos tus datos</a></p>
      <Fragment set:html="<!-- PENDIENTE CLIENTA: texto legal de privacidad y datos de menores; el enlace aún no tiene página -->" />
    </div>

    <!-- Paso 2: confirmación, sin salir de la página -->
    <div class="correo__paso" data-correo-paso="listo" hidden>
      <p class="correo__eti">Listo</p>
      <h2 class="correo__titulo" tabindex="-1" data-correo-foco>¡Gracias! Ya casi estamos.</h2>
      <p class="correo__sub" data-correo-mensaje></p>
      <button type="button" class="boton correo__volver" data-correo-cerrar>Seguir explorando</button>
    </div>
  </div>
</dialog>

<script>
  // Pantalla del correo: se abre con los botones del test, no bloquea y se cierra con Esc, fuera o con la X.
  const dlg = document.querySelector<HTMLDialogElement>('.correo');
  if (dlg) {
    const form = dlg.querySelector<HTMLFormElement>('[data-correo-form]')!;
    const input = dlg.querySelector<HTMLInputElement>('#correo-email')!;
    const error = dlg.querySelector<HTMLElement>('#correo-error')!;
    const pedir = dlg.querySelector<HTMLElement>('[data-correo-paso="pedir"]')!;
    const listo = dlg.querySelector<HTMLElement>('[data-correo-paso="listo"]')!;
    const mensaje = dlg.querySelector<HTMLElement>('[data-correo-mensaje]')!;
    const destino = dlg.dataset.destinoTest || '#';

    const abrir = () => {
      pedir.hidden = false; listo.hidden = true; error.hidden = true; input.removeAttribute('aria-invalid');
      if (!dlg.open) dlg.showModal();
      // el foco va al campo, sin teclado forzado en móvil (no abre de golpe el teclado a quien solo mira)
      input.focus({ preventScroll: true });
    };
    const cerrar = () => dlg.open && dlg.close();

    // Capturamos antes que el aviso genérico de la plantilla
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('a[href="#"].boton, a[href="#"].cfa__boton, [data-abrir-aviso], [data-abrir-correo]');
      if (!t || dlg.contains(t)) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      abrir();
    }, true);

    dlg.querySelectorAll('[data-correo-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) cerrar(); });

    const seguir = (conCorreo: string | null) => {
      if (destino !== '#') { location.href = destino; return; }
      // Mientras no haya test, confirmamos aquí con un mensaje honesto
      mensaje.textContent = conCorreo
        ? `Apuntado: te escribiremos a ${conCorreo} en cuanto el test esté listo, con tus resultados y todo lo necesario para explorar tu camino.`
        : 'Sin problema, no hace falta dejar el correo. En cuanto el test esté listo podrás hacerlo y ver tus resultados en pantalla.';
      pedir.hidden = true; listo.hidden = false;
      listo.querySelector<HTMLElement>('[data-correo-foco]')!.focus({ preventScroll: true });
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value.trim();
      if (!v) { // vacío: no se insiste, se ofrece seguir igualmente
        error.textContent = 'Si prefieres no dejarlo, puedes empezar igualmente con el botón de abajo.';
        error.hidden = false; input.setAttribute('aria-invalid', 'true'); return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) {
        error.textContent = 'Parece que falta algo en el correo. ¿Lo revisamos? (por ejemplo: nombre@correo.com)';
        error.hidden = false; input.setAttribute('aria-invalid', 'true'); input.focus(); return;
      }
      // PENDIENTE: enviar `v` al endpoint de la lista (hoy no se guarda en ningún sitio)
      seguir(v);
    });
    input.addEventListener('input', () => { error.hidden = true; input.removeAttribute('aria-invalid'); });
    dlg.querySelector('[data-correo-saltar]')!.addEventListener('click', () => seguir(null));
  }
</script>

<style is:global>
  .correo { padding: 0; border: 0; background: none; color: var(--crema); max-width: none; max-height: none; width: 100%; height: 100%; }
  .correo::backdrop { background: rgb(0 0 0 / 0.78); backdrop-filter: blur(8px); }
  .correo[open] { display: grid; place-items: center; overflow-y: auto; }
  .correo__caja {
    position: relative; width: min(100% - 1.5rem, 34rem); margin-block: 1rem; padding: clamp(1.75rem, 1.25rem + 2.4vw, 2.75rem) clamp(1.25rem, 0.9rem + 2vw, 2.5rem) clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    border-radius: 28px; background: var(--negro-2, #161412); border: 1px solid rgb(246 241 232 / 0.1);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.9);
    background-image: radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--acento) 16%, transparent), transparent 62%);
  }
  .correo__cerrar { position: absolute; top: 0.9rem; right: 0.9rem; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(246 241 232 / 0.14); background: none; color: var(--crema); cursor: pointer; transition: background-color 200ms ease; }
  .correo__cerrar:hover { background: rgb(246 241 232 / 0.08); }
  .correo__paso { display: grid; gap: 1rem; }
  .correo__paso[hidden] { display: none; }
  .correo__eti { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--acento-texto); }
  .correo__titulo { font-family: var(--titular); font-weight: 800; font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem); line-height: 1.08; letter-spacing: -0.02em; padding-right: 2.5rem; outline: 0; }
  .correo__sub { color: rgb(246 241 232 / 0.78); line-height: 1.6; font-size: var(--t2, 1rem); }

  .correo__form { display: grid; gap: 0.5rem; margin-top: 0.5rem; }
  .correo__label { font-size: 0.875rem; font-weight: 600; color: rgb(246 241 232 / 0.8); }
  .correo__campo input {
    width: 100%; min-height: 58px; padding: 0 1.1rem; border-radius: 16px; font: inherit; font-size: 1.0625rem; color: var(--crema);
    background: rgb(246 241 232 / 0.06); border: 1.5px solid rgb(246 241 232 / 0.18); transition: border-color 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }
  .correo__campo input::placeholder { color: rgb(246 241 232 / 0.4); }
  .correo__campo input:focus { outline: 0; border-color: var(--acento); background: rgb(246 241 232 / 0.09); box-shadow: 0 0 0 4px color-mix(in srgb, var(--acento) 22%, transparent); }
  .correo__campo input[aria-invalid='true'] { border-color: var(--acento-texto); }
  .correo__error { font-size: 0.875rem; color: var(--acento-texto); line-height: 1.45; }
  .correo__ayuda { font-size: 0.875rem; color: rgb(246 241 232 / 0.62); line-height: 1.45; }
  .correo__enviar { width: 100%; margin-top: 0.75rem; justify-content: center; align-items: center; gap: 0.5rem; min-height: 58px; border: 0; outline: 0; }
  .correo__enviar:focus-visible { outline: 2px solid var(--crema); outline-offset: 3px; }
  .correo__saltar { justify-self: center; margin-top: 0.25rem; padding: 0.75rem 0.5rem; border: 0; background: none; color: rgb(246 241 232 / 0.72); font: inherit; font-size: 0.9375rem; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: rgb(246 241 232 / 0.3); cursor: pointer; transition: color 200ms ease; }
  .correo__saltar:hover { color: var(--crema); text-decoration-color: currentColor; }

  .correo__confianza { list-style: none; margin: 0.75rem 0 0; padding: 1.25rem 0 0; display: grid; gap: 1rem; border-top: 1px solid rgb(246 241 232 / 0.1); }
  .correo__confianza li { display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: start; font-size: 0.9375rem; line-height: 1.5; color: rgb(246 241 232 / 0.72); }
  .correo__confianza strong { display: block; color: var(--crema); font-weight: 700; }
  .correo__ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: color-mix(in srgb, var(--acento) 18%, transparent); color: var(--acento-texto); }
  .correo__ic svg { width: 18px; height: 18px; }
  .correo__micro { font-size: 0.8125rem; color: rgb(246 241 232 / 0.55); margin-top: 0.25rem; }
  .correo__micro a { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .correo__volver { justify-self: start; margin-top: 0.5rem; }

  @media (prefers-reduced-motion: no-preference) {
    .correo[open] .correo__caja { animation: correo-entra 320ms cubic-bezier(.2,.7,.2,1); }
    @keyframes correo-entra { from { opacity: 0; translate: 0 18px; scale: 0.985; } }
  }
</style>
