---
import { Picture } from 'astro:assets';
import { noEresElUnico as b } from '../data/home';
---

<section class="unico bloque" aria-labelledby="unico-titulo">
  <header class="unico__cabecera contenedor" data-aparece>
    <p class="etiqueta">{b.etiqueta}</p>
    <h2 id="unico-titulo">{b.titulo}</h2>
  </header>

  <ul class="unico__lista carril" role="list" tabindex="0" aria-label="Testimonios">
    {
      b.personas.map((p) => (
        <li>
          <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
          <figure class="tarjeta" data-placeholder={p.placeholder ? 'true' : undefined}>
            <Picture
              src={p.foto}
              formats={['avif', 'webp']}
              widths={[320, 480, 640]}
              sizes="(min-width: 64rem) 18rem, (min-width: 48rem) 45vw, 78vw"
              alt={p.alt}
              class="tarjeta__foto"
            />
            <blockquote class="tarjeta__cita">
              <p>«{p.cita}»</p>
            </blockquote>
            <figcaption class="tarjeta__firma">
              — {p.nombre}, {p.edad}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .unico__cabecera {
    display: grid;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
  }

  .unico__cabecera h2 {
    font-size: var(--t-5);
    max-width: 16ch;
  }

  .tarjeta {
    display: grid;
    gap: var(--e-2);
    height: 100%;
    align-content: start;
  }

  .tarjeta :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radio);
  }

  .tarjeta__cita {
    font-size: var(--t-4);
    font-weight: 600;
    line-height: 1.15;
  }

  .tarjeta__firma {
    margin-top: auto;
    font-size: var(--t-1);
    color: var(--hueso-suave);
  }

  @media (min-width: 48rem) {
    .unico__cabecera {
      justify-items: center;
      text-align: center;
    }

    .unico__lista {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--e-4) var(--e-3);
      width: min(100% - 2 * var(--margen), var(--ancho));
      margin-inline: auto;
      padding: 0;
      overflow: visible;
    }
  }

  @media (min-width: 64rem) {
    .unico__lista {
      grid-template-columns: repeat(4, 1fr);
    }

    .tarjeta__cita {
      font-size: clamp(1.25rem, 0.9rem + 0.6vw, 1.5rem);
    }
  }
</style>
