---
// Logo: "Next" en serif, "You" en cursiva y ámbar. Se escribe siempre NextYou.
interface Props {
  tam?: 'menu' | 'pie';
}
const { tam = 'menu' } = Astro.props;
---

<span class:list={['logo', `logo--${tam}`]}>Next<em>You</em></span>

<style>
  .logo {
    font-family: var(--serif);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
    white-space: nowrap;
  }
  .logo em {
    font-family: 'Fraunces Logo', var(--serif);
    font-style: italic;
    font-weight: 600;
    color: var(--ambar);
    padding-left: 0.02em;
  }
  .logo--menu {
    font-size: 1.5rem;
  }
  .logo--pie {
    font-size: 2rem;
  }
</style>
