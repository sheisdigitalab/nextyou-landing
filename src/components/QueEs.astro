---
// Reducido a tres frases. Los cinco puntos del PDF repetían "Cómo funciona".
// A la derecha, «tu jornada»: el resultado del test, para que se vea qué te llevas.
import Icono from './Icono.astro';
import { queEsNextYou as b } from '../data/home';

const iconos = ['dentro', 'brujula'] as const;
---

<section class="que bloque" aria-labelledby="que-titulo">
  <div class="que__rejilla contenedor">
    <div class="que__texto" data-aparece>
      <p class="etiqueta">{b.etiqueta}</p>
      <h2 id="que-titulo">{b.titulo}</h2>
      <ul class="que__frases" role="list">
        {
          b.frases.map((f, i) => (
            <li>
              <Icono nombre={iconos[i % iconos.length]} tam={44} />
              <p>{f}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="jornada claro cinta" aria-labelledby="jornada-titulo">
      <p class="nota jornada__nota" aria-hidden="true">{b.jornada.nota} ↓</p>
      <div class="jornada__cabecera">
        <h3 id="jornada-titulo" class="jornada__titulo">{b.jornada.titulo}</h3>
        <span class="pastilla pastilla--negra">martes</span>
      </div>
      <ol class="jornada__lista" role="list">
        {
          b.jornada.tareas.map((t) => (
            <li class="jornada__fila">
              <span class="jornada__hora">{t.hora}</span>
              <span class="jornada__tarea">{t.tarea}</span>
              <span class="jornada__quien">con {t.quien}</span>
            </li>
          ))
        }
      </ol>
      <figcaption class="jornada__pie">{b.jornada.pie}</figcaption>
    </figure>
  </div>
</section>

<style>
  .que {
    border-top: 1px solid var(--linea);
  }

  .que__rejilla {
    display: grid;
    gap: var(--e-5);
    align-items: center;
  }

  .que__texto {
    display: grid;
    gap: var(--e-3);
  }

  .que__texto h2 {
    font-size: var(--t-5);
    max-width: 14ch;
  }

  .que__frases {
    display: grid;
    gap: var(--e-3);
    max-width: 32rem;
  }

  .que__frases li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-2);
    align-items: start;
  }

  .que__frases :global(.icono) {
    color: var(--hueso);
    flex-shrink: 0;
  }

  .que__frases p {
    font-size: var(--t-3);
    line-height: 1.45;
    padding-top: 0.25rem;
  }

  /* ---------- Tu jornada: hoja de agenda pegada con cinta ---------- */
  .jornada {
    position: relative;
    display: grid;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-3) var(--e-3);
    border-radius: 6px;
    background: var(--papel);
    color: var(--negro);
    rotate: 1.2deg;
  }

  .jornada__nota {
    position: absolute;
    top: -2.6rem;
    right: 0.5rem;
    font-size: 1.15rem;
  }

  .jornada__cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-2);
  }

  .jornada__titulo {
    font-size: var(--t-4);
  }

  .pastilla--negra {
    background: var(--negro);
    color: var(--hueso);
  }

  .jornada__lista {
    display: grid;
  }

  /* Cada hora es una fila de agenda; las horas vacías no aparecen. */
  .jornada__fila {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.25rem var(--e-2);
    padding-block: 0.875rem;
    border-top: 1.5px dashed rgb(22 20 18 / 0.2);
  }

  .jornada__hora {
    grid-row: span 2;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .jornada__tarea {
    font-weight: 600;
    line-height: 1.35;
  }

  .jornada__quien {
    font-family: var(--mano);
    font-size: 1rem;
    color: var(--gris);
  }

  .jornada__pie {
    padding-top: var(--e-1);
    border-top: 1.5px dashed rgb(22 20 18 / 0.2);
    font-size: var(--t-1);
    color: var(--gris);
  }

  @media (min-width: 48rem) {
    .que__rejilla {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--e-5);
    }
  }
</style>
