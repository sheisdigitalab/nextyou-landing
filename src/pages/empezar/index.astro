---
// Página «Antes de empezar»: pide nombre y correo antes del test, sin modal ni presión.
// Una sola pantalla con dos partes: a la izquierda el porqué (claro y a la vista, sin tener que bajar) y a la derecha los dos campos.
//
// PENDIENTE CLIENTA / DESARROLLO (no está activo hasta decidirlo):
//  - Destino real de los datos (lista de envío / CRM): hoy NO se guardan ni se envían en ningún sitio.
//  - Texto legal y de menores (hay personas de 16-17 años) y página de privacidad (el enlace aún es '#').
//  - URL real del test: cuando exista, `DESTINO_TEST` redirige ahí tras este paso.
import V5 from '../../layouts/V5.astro';
import { BASE, ENLACES } from '../../config';

const INICIO = `${BASE}v7/`;
const DESTINO_TEST = '#'; // PENDIENTE: URL del test
---

<V5
  titulo="Antes de empezar · NextYou"
  descripcion="Para poder enviarte tus resultados necesitamos tu nombre y tu correo. Solo los usamos para eso."
  actual="bachillerato"
  soloBachillerato
  ruta="v7/"
>
  <main id="contenido" class="empezar">
    <div class="ancho empezar__rejilla">
      <!-- Parte 1: el porqué, arriba y claro -->
      <section class="empezar__texto" aria-labelledby="empezar-titulo">
        <a class="empezar__volver" href={INICIO}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Volver
        </a>
        <h1 id="empezar-titulo" class="empezar__titulo">Antes de empezar…</h1>
        <p class="empezar__lead">Necesitamos un par de datos para poder enviarte tus resultados. Son solo dos, y te explicamos para qué.</p>

        <ul class="empezar__porque" role="list" aria-label="Por qué te lo pedimos">
          <li>
            <span class="empezar__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"/></svg></span>
            <span><strong>Tu nombre</strong>para dirigirnos a ti como tú quieras. Puede ser tu nombre, un apodo o como prefieras.</span>
          </li>
          <li>
            <span class="empezar__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="6" width="17" height="12.5" rx="2.5"/><path d="M4 7.5l8 6 8-6"/></svg></span>
            <span><strong>Tu correo</strong>para que recibas toda la información y el acompañamiento: tus resultados, tus 3 caminos y las ideas para explorar el tuyo.</span>
          </li>
        </ul>

        <p class="empezar__promesa">
          <span class="empezar__ic empezar__ic--sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg></span>
          <span>Solo los usamos para esto. <strong>Nunca los compartimos ni los vendemos</strong>, no te llenamos de publicidad y puedes darte de baja con un clic.</span>
        </p>
      </section>

      <!-- Parte 2: los dos campos -->
      <section class="empezar__tarjeta" aria-label="Tus datos">
        <div data-empezar-paso="pedir">
          <form class="empezar__form" novalidate data-empezar-form>
            <div class="empezar__campo">
              <label for="empezar-nombre">¿Cómo quieres que te llamemos?</label>
              <input id="empezar-nombre" name="nombre" type="text" autocomplete="given-name" autocapitalize="words" placeholder="Tu nombre o como prefieras" maxlength="60" />
            </div>
            <div class="empezar__campo">
              <label for="empezar-correo">Tu correo</label>
              <input id="empezar-correo" name="correo" type="email" inputmode="email" autocomplete="email" placeholder="nombre@correo.com" aria-describedby="empezar-ayuda empezar-error" />
              <p id="empezar-ayuda" class="empezar__ayuda">Aquí te mandamos tus resultados y el acompañamiento.</p>
              <p id="empezar-error" class="empezar__error" role="alert" hidden></p>
            </div>

            <button type="submit" class="boton empezar__enviar">
              <span>Explorar mi camino</span><span aria-hidden="true">→</span>
            </button>
            <button type="button" class="empezar__saltar" data-empezar-saltar>Prefiero empezar sin dejar mis datos</button>
          </form>
          <p class="empezar__micro">8 minutos · gratis · sin tarjeta. <a href={ENLACES.privacidad}>Cómo cuidamos tus datos</a></p>
          <Fragment set:html="<!-- PENDIENTE CLIENTA: texto legal de privacidad y de menores; el enlace aún no tiene página -->" />
        </div>

        <div class="empezar__listo" data-empezar-paso="listo" hidden>
          <h2 class="empezar__listo-titulo" tabindex="-1" data-empezar-foco>¡Gracias!</h2>
          <p data-empezar-mensaje></p>
          <a class="boton" href={INICIO}>Seguir explorando</a>
        </div>
      </section>
    </div>
  </main>

  <script is:inline define:vars={{ DESTINO_TEST }}>
    (function () {
      var form = document.querySelector('[data-empezar-form]');
      if (!form) return;
      var nombre = document.getElementById('empezar-nombre');
      var correo = document.getElementById('empezar-correo');
      var error = document.getElementById('empezar-error');
      var pedir = document.querySelector('[data-empezar-paso="pedir"]');
      var listo = document.querySelector('[data-empezar-paso="listo"]');
      var mensaje = document.querySelector('[data-empezar-mensaje]');
      var titulo = document.querySelector('.empezar__listo-titulo');

      function seguir(n, c) {
        if (DESTINO_TEST !== '#') { location.href = DESTINO_TEST; return; }
        // Mientras no haya test ni destino de datos, lo decimos tal cual
        titulo.textContent = n ? '¡Gracias, ' + n + '!' : '¡Gracias!';
        mensaje.textContent = c
          ? 'Te escribiremos a ' + c + ' en cuanto el test esté listo, con tus resultados y todo lo necesario para explorar tu camino.'
          : 'No hace falta dejar tus datos. En cuanto el test esté listo podrás hacerlo y ver tus resultados en pantalla.';
        pedir.hidden = true; listo.hidden = false;
        titulo.focus({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      function mostrarError(texto) { error.textContent = texto; error.hidden = false; correo.setAttribute('aria-invalid', 'true'); }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var c = correo.value.trim();
        var n = nombre.value.trim();
        if (!c) { mostrarError('Si prefieres no dejarlo, puedes empezar igualmente con el botón de abajo.'); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(c)) { mostrarError('Parece que falta algo en el correo. ¿Lo revisamos? (por ejemplo: nombre@correo.com)'); correo.focus(); return; }
        // PENDIENTE: enviar nombre y correo al destino real (hoy no se guardan en ningún sitio)
        seguir(n, c);
      });
      correo.addEventListener('input', function () { error.hidden = true; correo.removeAttribute('aria-invalid'); });
      document.querySelector('[data-empezar-saltar]').addEventListener('click', function () { seguir(nombre.value.trim(), null); });
    })();
  </script>
</V5>

<style is:global>
  .empezar { background: var(--negro-2, #161412); color: var(--crema); padding-block: clamp(1.5rem, 1rem + 2vw, 3.5rem) var(--aire, 6rem); min-height: calc(100svh - 125px); }
  .empezar__rejilla { display: grid; gap: clamp(2rem, 1.5rem + 2.5vw, 4rem); align-items: start; }
  @media (min-width: 60rem) { .empezar__rejilla { grid-template-columns: 1.05fr 0.95fr; align-items: center; } }

  .empezar__texto { display: grid; gap: 1.25rem; justify-items: start; }
  .empezar__volver { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; color: rgb(246 241 232 / 0.7); font-size: 0.9375rem; text-decoration: none; transition: color 200ms ease; }
  .empezar__volver:hover { color: var(--crema); }
  .empezar__titulo { font-family: var(--titular); font-weight: 800; font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem); line-height: 1.04; letter-spacing: -0.025em; }
  .empezar__lead { max-width: 34rem; font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem); line-height: 1.55; color: rgb(246 241 232 / 0.82); }

  .empezar__porque { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 1.1rem; max-width: 36rem; }
  .empezar__porque li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; line-height: 1.55; color: rgb(246 241 232 / 0.75); }
  .empezar__porque strong { display: block; color: var(--crema); font-weight: 700; font-size: 1.0625rem; margin-bottom: 0.1rem; }
  .empezar__ic { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: color-mix(in srgb, var(--acento) 18%, transparent); color: var(--acento-texto); }
  .empezar__ic svg { width: 22px; height: 22px; }
  .empezar__ic--sm { width: 36px; height: 36px; }
  .empezar__ic--sm svg { width: 18px; height: 18px; }
  .empezar__promesa { display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: start; max-width: 36rem; margin-top: 0.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(246 241 232 / 0.12); line-height: 1.55; color: rgb(246 241 232 / 0.75); font-size: 0.9375rem; }
  .empezar__promesa strong { color: var(--crema); }

  .empezar__tarjeta {
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); border-radius: 28px; border: 1px solid rgb(246 241 232 / 0.1);
    background: color-mix(in srgb, var(--crema) 4%, var(--negro-2, #161412));
    background-image: radial-gradient(120% 60% at 50% 0%, color-mix(in srgb, var(--acento) 14%, transparent), transparent 65%);
  }
  .empezar__form { display: grid; gap: 1.25rem; }
  .empezar__campo { display: grid; gap: 0.45rem; }
  .empezar__campo label { font-size: 0.9375rem; font-weight: 600; color: var(--crema); }
  .empezar__campo input { width: 100%; min-height: 58px; padding: 0 1.1rem; border-radius: 16px; font: inherit; font-size: 1.0625rem; color: var(--crema); background: rgb(246 241 232 / 0.06); border: 1.5px solid rgb(246 241 232 / 0.18); transition: border-color 200ms ease, background-color 200ms ease, box-shadow 200ms ease; }
  .empezar__campo input::placeholder { color: rgb(246 241 232 / 0.4); }
  .empezar__campo input:focus { outline: 0; border-color: var(--acento); background: rgb(246 241 232 / 0.09); box-shadow: 0 0 0 4px color-mix(in srgb, var(--acento) 22%, transparent); }
  .empezar__campo input[aria-invalid='true'] { border-color: var(--acento-texto); }
  .empezar__ayuda { font-size: 0.875rem; line-height: 1.45; color: rgb(246 241 232 / 0.62); }
  .empezar__error { font-size: 0.875rem; line-height: 1.45; color: var(--acento-texto); }
  .empezar .empezar__enviar { justify-self: start; justify-content: center; align-items: center; gap: 0.5rem; min-height: 52px; padding: 0 1.75rem; margin-top: 0.25rem; border: 0; font-size: 1rem; }
  @media (max-width: 30rem) { .empezar .empezar__enviar { justify-self: stretch; } }
  .empezar__saltar { justify-self: center; padding: 0.75rem 0.5rem; border: 0; background: none; color: rgb(246 241 232 / 0.72); font: inherit; font-size: 0.9375rem; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: rgb(246 241 232 / 0.3); cursor: pointer; transition: color 200ms ease; }
  .empezar__saltar:hover { color: var(--crema); text-decoration-color: currentColor; }
  .empezar__micro { margin-top: 1rem; text-align: center; font-size: 0.8125rem; color: rgb(246 241 232 / 0.55); }
  .empezar__micro a { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .empezar__listo { display: grid; gap: 1rem; justify-items: start; }
  .empezar__listo[hidden], [data-empezar-paso][hidden] { display: none; }
  .empezar__listo-titulo { font-family: var(--titular); font-weight: 800; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); line-height: 1.1; outline: 0; }
  .empezar__listo p { color: rgb(246 241 232 / 0.8); line-height: 1.6; }

  /* Esta página no lleva botón fijo del test ni cierre: es el propio paso */
  @media (prefers-reduced-motion: no-preference) {
    .empezar__tarjeta { animation: empezar-entra 420ms cubic-bezier(.2,.7,.2,1); }
    @keyframes empezar-entra { from { opacity: 0; translate: 0 14px; } }
  }
</style>
