---
// La versión 7 es ahora la portada de la web. Esta dirección antigua redirige para que los enlaces ya enviados sigan funcionando.
import { BASE } from '../../config';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${BASE}`} />
    <link rel="canonical" href={BASE} />
    <title>NextYou</title>
    <script is:inline define:vars={{ BASE }}>
      location.replace(BASE + location.search + location.hash);
    </script>
  </head>
  <body></body>
</html>
