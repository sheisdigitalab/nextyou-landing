---
import Base from '../layouts/Base.astro';
import Menu from '../components/Menu.astro';
import Hero from '../components/Hero.astro';
import Marquesina from '../components/Marquesina.astro';
import NoEresElUnico from '../components/NoEresElUnico.astro';
import QueEs from '../components/QueEs.astro';
import LosDeDentro from '../components/LosDeDentro.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import QuienHayDetras from '../components/QuienHayDetras.astro';
import Sara from '../components/Sara.astro';
import Pie from '../components/Pie.astro';
---

<Base>
  <Menu />
  <main id="contenido">
    <Hero />
    <Marquesina />
    <NoEresElUnico />
    <QueEs />
    <LosDeDentro />
    <ComoFunciona />
    <QuienHayDetras />
    <!-- PENDIENTE de decisión de la clienta: bloque de familias. No inventar. -->
    <Sara />
  </main>
  <Pie />
</Base>
