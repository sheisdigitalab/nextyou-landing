      .nopasa svg { flex-shrink: 0; color: #b0301b; translate: 0 2px; }
      @media (min-width: 48rem) { .nopasa ul { grid-template-columns: 1fr 1fr; } }
      .como__cta { margin-top: 2.5rem; gap: 1.25rem; }
