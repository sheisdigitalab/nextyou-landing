      .nopasa { margin-top: 3rem; padding: clamp(1.75rem, 1.25rem + 2vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: 16px; background: var(--beige); color: var(--negro); }
