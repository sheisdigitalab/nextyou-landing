---
// Versión 2 de la home: el diseño de Figma (archivo «NextYou», marco «Crear landing page»)
// con los 15 comentarios de Sara y las mejoras de SEO aplicadas.
// Página independiente, con su propio estilo: no usa global.css ni los componentes de la v1.
// Los textos salen de src/data/home.ts, los mismos que la v1. Personas y fotos DE MUESTRA.
import { Image } from 'astro:assets';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../../config';
import { hero, noEresElUnico, queEsNextYou as q, losDeDentro, sara } from '../../data/home';
import fraunces from '../../assets/fonts/fraunces.woff2?url';
import frauncesItalica from '../../assets/fonts/fraunces-italic.woff2?url';
import caveat from '../../assets/fonts/caveat.woff2?url';
import archivo from '../../assets/fonts/archivo.woff2?url';

// Menú por perfiles (comentario #2). La home es la de bachillerato.
const menu = [
  { texto: 'Estoy en bachillerato', href: `${BASE}v2/`, actual: true },
  { texto: 'Estoy en la universidad', href: ENLACES.universidad, actual: false },
  { texto: 'Soy madre o padre', href: ENLACES.familias, actual: false },
];

const pie = [
  { texto: 'Historias', href: ENLACES.historias },
  { texto: 'Profesiones', href: ENLACES.profesiones },
  { texto: 'Soy madre o padre', href: ENLACES.familias },
  { texto: 'Sobre Sara', href: ENLACES.sara },
  { texto: 'Privacidad', href: ENLACES.privacidad },
  { texto: 'Datos y menores', href: ENLACES.menores },
];

const reels = losDeDentro.personas;
const insider = reels[0];

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITIO.titulo}</title>
    <meta name="description" content={SITIO.descripcion} />
    <!-- Vista previa de una versión alternativa: nunca se indexa -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <style set:html={`
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 100 900; font-display: swap; src: url('${fraunces}') format('woff2-variations'); }
      @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 100 900; font-display: swap; src: url('${frauncesItalica}') format('woff2-variations'); }
      @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400; font-display: swap; src: url('${caveat}') format('woff2'); }
      @font-face { font-family: 'Archivo'; font-style: normal; font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; src: url('${archivo}') format('woff2-variations'); }
    `} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <!-- ===================== Menú ===================== -->
    <header class="menu">
      <div class="menu__barra ancho">
        <a href={`${BASE}v2/`} class="logo" aria-label="NextYou, inicio">Next<em>You</em></a>
        <nav class="menu__nav" aria-label="Principal">
          <button class="menu__abrir" type="button" aria-expanded="false" aria-controls="menu-enlaces">
            <span class="solo-lector">Menú</span>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <ul id="menu-enlaces" class="menu__enlaces" role="list">
            {menu.map((e) => (
              <li>
                {e.href === '#' && <Fragment set:html="<!-- PENDIENTE: página fase posterior -->" />}
                <a href={e.href} aria-current={e.actual ? 'page' : undefined}>{e.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href={CTA_PRINCIPAL.href} class="boton boton--sm menu__cta">Test gratis</a>
      </div>
    </header>

    <main id="contenido">
      <!-- ===================== Hero ===================== -->
      <section class="hero" aria-labelledby="hero-titulo">
        <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
        <Image
          src={hero.foto}
          alt={hero.alt}
          widths={[640, 1080, 1440, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero__foto"
        />
        <div class="hero__contenido ancho">
          <span class="hero__ver">
            <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
            Ver a {hero.nombre} · 2 min
          </span>
          <div class="hero__abajo">
            <figure class="hero__cita">
              <blockquote><p>«{hero.cita}»</p></blockquote>
              <figcaption>
                <span class="hero__nombre">{hero.nombre}, {hero.edad}</span>
                <span class="hero__detalle">{hero.detalle}</span>
              </figcaption>
            </figure>
            <!-- Qué es NextYou, junto y en un bloque (comentario #3) -->
            <div class="hero__que">
              <h1 id="hero-titulo">{hero.titular}</h1>
              <p>{hero.texto}</p>
              <div class="hero__accion">
                <a href={CTA_PRINCIPAL.href} class="boton">{hero.boton}</a>
                <span>8 minutos · gratis · sin crear cuenta</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== No eres el único ===================== -->
      <section class="seccion unico" aria-labelledby="unico-titulo">
        <div class="ancho">
          <header class="cabecera cabecera--centro">
            <p class="antetitulo">{noEresElUnico.etiqueta}</p>
            <h2 id="unico-titulo" class="titular titular--unico" set:html={cursiva(noEresElUnico.titulo, noEresElUnico.resaltado)} />
            <p class="cabecera__sub">{noEresElUnico.subtitulo}</p>
          </header>
          <ul class="unico__lista" role="list" aria-label="Testimonios" tabindex="0">
            {
              noEresElUnico.personas.map((p) => (
                <li class="tarjeta">
                  <Image src={p.foto} alt={p.alt} width={480} height={420} class="tarjeta__foto" />
                  <div class="tarjeta__texto">
                    <p class="tarjeta__cita">«{p.cita}»</p>
                    <p class="tarjeta__firma">— {p.nombre}, {p.edad}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ===================== ¿Qué es NextYou? =====================
           Fondo claro (#6), en modo pregunta con el logo (#7), titular de Sara (#8)
           y una demo del producto en lugar de las frases y del «Cómo funciona» (#9, #12).
           «Lo que no va a pasar» integrado como lista, sin caja de color (#13). -->
      <section class="seccion que" aria-labelledby="que-titulo">
        <div class="estrecho">
          <header class="que__cabecera">
            <p class="que__pregunta">¿Qué es <span class="logo logo--grande">Next<em>You</em></span>?</p>
            <h2 id="que-titulo" set:html={cursiva(q.titulo, q.resaltado)} />
          </header>

          <ol class="demo" role="list">
            <li class="demo__paso">
              <div class="pantalla" aria-hidden="true">
                <p class="pantalla__titulo">Sábado sin planes. ¿Qué te apetece?</p>
                <p class="pantalla__tarea">Grabar y editar un vídeo</p>
                <div class="pantalla__resp">
                  {q.respuestas.map((r, i) => <span class:list={{ sel: i === 3 }}>{r}</span>)}
                </div>
              </div>
              <span class="demo__n" aria-hidden="true">01</span>
              <h3>{q.pasos[0].titulo}</h3>
              <p>{q.pasos[0].texto}</p>
              <span class="pastilla">{q.pasos[0].tiempo}</span>
            </li>
            <li class="demo__paso">
              <div class="pantalla" aria-hidden="true">
                <p class="pantalla__titulo">Tus tres caminos</p>
                {q.caminos.map((c, i) => (
                  <p class="pantalla__camino"><span class:list={['pantalla__punto', { lleno: i === 0 }]} />{c}</p>
                ))}
              </div>
              <span class="demo__n" aria-hidden="true">02</span>
              <h3>{q.pasos[1].titulo}</h3>
              <p>{q.pasos[1].texto}</p>
              <span class="pastilla">{q.pasos[1].tiempo}</span>
            </li>
            <li class="demo__paso">
              <div class="pantalla pantalla--foto" aria-hidden="true">
                <Image src={insider.foto} alt="" width={360} height={420} class="pantalla__img" />
                <span class="pantalla__dur">▷ {insider.duracion}</span>
                <p class="pantalla__pie"><strong>{insider.nombre}, {insider.edad}</strong>{insider.profesion}</p>
              </div>
              <span class="demo__n" aria-hidden="true">03</span>
              <h3>{q.pasos[2].titulo}</h3>
              <p>{q.pasos[2].texto}</p>
              <span class="pastilla">{q.pasos[2].tiempo}</span>
            </li>
            <li class="demo__paso">
              <div class="pantalla" aria-hidden="true">
                <p class="pantalla__titulo">Sesión con tu coach</p>
                <p class="pantalla__burbuja">¿Qué te dio más energía esta semana?</p>
                <p class="pantalla__burbuja pantalla__burbuja--tu">El reto de diseño, sin duda</p>
                <p class="pantalla__meta">online · 1 al mes</p>
              </div>
              <span class="demo__n" aria-hidden="true">04</span>
              <h3>{q.pasos[3].titulo}</h3>
              <p>{q.pasos[3].texto}</p>
              <span class="pastilla pastilla--contorno">{q.pasos[3].tiempo}</span>
            </li>
          </ol>

          <div class="que__pie">
            <ul class="nopasa" role="list" aria-label="Lo que no va a pasar">
              {q.noVaAPasar.map((t) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  {t}
                </li>
              ))}
            </ul>
            <Fragment set:html="<!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->" />
            <a href={CTA_PRINCIPAL.href} class="boton">{q.boton}</a>
          </div>
        </div>
      </section>

      <!-- ===================== Los de dentro ===================== -->
      <section class="seccion dentro" aria-labelledby="dentro-titulo">
        <div class="ancho">
          <header class="cabecera cabecera--centro">
            <p class="antetitulo">{losDeDentro.etiqueta}</p>
            <h2 id="dentro-titulo" class="titular titular--dentro" set:html={cursiva(losDeDentro.titulo, losDeDentro.resaltado)} />
            <p class="cabecera__sub">Sin discursos. Te cuentan cómo entraron, en qué se equivocaron y cómo es un martes cualquiera.</p>
          </header>
          <div class="dentro__nav">
            <button type="button" class="flecha" data-mover="-1" aria-label="Anterior" disabled>←</button>
            <span class="dentro__cuenta" aria-live="polite"><span data-actual>1</span> / {reels.length}</span>
            <button type="button" class="flecha" data-mover="1" aria-label="Siguiente">→</button>
          </div>
        </div>
        <Fragment set:html="<!-- PENDIENTE: clips de noviembre de Sara (comentario #11) -->" />
        <ul class="reels" role="list" aria-label="Vídeos de profesionales" tabindex="0">
          {
            reels.map((p) => (
              <li class="reel">
                <Image src={p.foto} alt={p.alt} width={600} height={800} loading="eager" class="reel__foto" />
                <span class="reel__dur">
                  <svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                  {p.duracion}
                </span>
                <div class="reel__pie">
                  <p class="reel__nombre">{p.nombre}, {p.edad}</p>
                  <span class="etiqueta-marco etiqueta-marco--grande">{p.profesion}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="ancho">
          <div class="puntos" aria-hidden="true">
            {reels.map((_, i) => <span class:list={{ activo: i === 0 }} />)}
          </div>
        </div>
      </section>

      <!-- ===================== Sara · fondo oscuro (comentario #15). Texto provisional suyo. ===================== -->
      <section class="sara" aria-labelledby="sara-titulo">
        <div class="estrecho sara__rejilla">
          <div class="sara__texto">
            <p class="antetitulo">{sara.etiqueta}</p>
            <h2 id="sara-titulo" class="titular titular--sara">{sara.titulo}</h2>
            <p>{sara.texto}</p>
            <p class="firma">{sara.firma}</p>
            <a href={ENLACES.sara} class="boton boton--contorno">{sara.boton}</a>
          </div>
          <Fragment set:html="<!-- PENDIENTE: foto de Sara -->" />
          <div class="sara__foto" role="img" aria-label="Foto de Sara, pendiente">
            <span class="sara__aviso" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
              Aquí irá la foto de Sara
            </span>
            <p><strong>Sara</strong>{sara.cargo}</p>
          </div>
        </div>
      </section>
    </main>

    <!-- ===================== Pie ===================== -->
    <footer class="pie">
      <div class="estrecho">
        <div class="pie__arriba">
          <a href={`${BASE}v2/`} class="logo logo--pie" aria-label="NextYou, inicio">Next<em>You</em></a>
          <nav aria-label="Pie">
            <ul role="list">{pie.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}</ul>
          </nav>
        </div>
        <p class="pie__lema">Tu futuro no se adivina. Se explora.</p>
      </div>
    </footer>

    <script>
      // Menú móvil
      const abrir = document.querySelector<HTMLButtonElement>('.menu__abrir');
      const lista = document.getElementById('menu-enlaces');
      if (abrir && lista) {
        abrir.addEventListener('click', () => {
          const abierto = abrir.getAttribute('aria-expanded') === 'true';
          abrir.setAttribute('aria-expanded', String(!abierto));
          lista.classList.toggle('abierto', !abierto);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && abrir.getAttribute('aria-expanded') === 'true') {
            abrir.setAttribute('aria-expanded', 'false');
            lista.classList.remove('abierto');
            abrir.focus();
          }
        });
      }

      // Carrusel de «Los de dentro»: flechas, contador y puntos sobre un scroll nativo.
      const pista = document.querySelector<HTMLElement>('.reels');
      const botones = document.querySelectorAll<HTMLButtonElement>('[data-mover]');
      const actual = document.querySelector('[data-actual]');
      const puntos = document.querySelectorAll('.puntos span');
      if (pista) {
        const items = [...pista.children] as HTMLElement[];
        const paso = () => items[1].offsetLeft - items[0].offsetLeft;
        const indice = () => Math.round(pista.scrollLeft / paso());
        const pintar = () => {
          const i = Math.min(indice(), items.length - 1);
          if (actual) actual.textContent = String(i + 1);
          puntos.forEach((p, n) => p.classList.toggle('activo', n === i));
          const fin = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
          botones[0].disabled = pista.scrollLeft <= 4;
          botones[1].disabled = fin;
        };
        botones.forEach((b) =>
          b.addEventListener('click', () => pista.scrollBy({ left: paso() * Number(b.dataset.mover), behavior: 'smooth' }))
        );
        pista.addEventListener('scroll', () => requestAnimationFrame(pintar), { passive: true });
        pintar();
      }
    </script>

    <style is:global>
      :root {
        --negro: #000;
        --negro-2: #0f0b09;  /* bandas: menú, «Los de dentro», pie */
        --tarjeta: #141210;
        --crema: #f6f1e8;
        --beige: #e3d3be;
        --beige-2: #c8b89f;
        --rojo: #c93a22;     /* botones (texto crema encima: 5,1:1) */
        --rojo-texto: #e2533a; /* antetítulos y marcos sobre negro: 5,3:1 */
        --gris: #a39d94;     /* texto secundario sobre negro */
        --gris-oscuro: #574e46; /* texto secundario sobre claro */
        --rojo-oscuro: #a52b17; /* rojo como texto sobre claro: 5,6:1 */
        --papel: #f6f1e8;
        --linea: rgb(246 241 232 / 0.1);
        --serif: 'Fraunces', Georgia, serif;
        --sans: 'Archivo', system-ui, sans-serif;
        --mano: 'Caveat', cursive;
        --margen: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        background: var(--negro);
        color: var(--crema);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img { display: block; max-width: 100%; height: auto; }
      ul, ol { padding: 0; list-style: none; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--crema); outline-offset: 3px; }

      .ancho { width: min(100% - 2 * var(--margen), 85rem); margin-inline: auto; }
      .estrecho { width: min(100% - 2 * var(--margen), 72rem); margin-inline: auto; }
      .centro { display: grid; justify-items: center; text-align: center; }

      .saltar { position: absolute; left: 1rem; top: -100px; z-index: 100; padding: 0.75rem 1.25rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-weight: 600; }
      .saltar:focus { top: 0.75rem; }
      .solo-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* Logo provisional en texto, como en Figma */
      .logo { font-family: var(--serif); font-weight: 700; font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem); letter-spacing: -0.02em; text-decoration: none; font-variation-settings: 'opsz' 72; }
      .logo em { color: var(--rojo-texto); font-style: italic; font-weight: 600; }
      .logo--pie { font-size: 2.25rem; }
      .logo--grande { font-size: 1em; }
      .logo--grande em { color: var(--rojo-oscuro); }

      /* Botones */
      .boton {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 48px; padding: 0.75rem 2.5rem; border-radius: 999px;
        background: var(--rojo); color: var(--crema);
        font-weight: 600; font-size: 1rem; text-decoration: none;
        transition: background 150ms ease, transform 150ms ease;
      }
      .boton:hover { background: #b0301b; }
      .boton:active { transform: scale(0.98); }
      .boton--sm { min-height: 44px; padding: 0.5rem 1.25rem; font-size: 0.9375rem; }
      .boton--grande { min-height: 64px; font-size: 1.125rem; }
      .boton--contorno { background: none; color: var(--crema); border: 1.5px solid var(--crema); padding-inline: 1.5rem; }
      .boton--contorno:hover { background: var(--crema); color: var(--negro); }

      /* Textos comunes */
      .antetitulo { color: var(--rojo-texto); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
      .antetitulo--gris { color: var(--gris-oscuro); }
      .titular { font-family: var(--serif); font-weight: 600; font-size: clamp(2.125rem, 1.4rem + 3vw, 3.75rem); line-height: 1.04; letter-spacing: -0.02em; text-wrap: balance; }
      .titular--grande { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem); }
      .titular--ancho { max-width: 22ch; }
      .titular em { font-style: italic; color: var(--rojo-texto); }
      .titular--unico { max-width: 20ch !important; }
      .titular--dentro { max-width: 20ch !important; }
      .titular--sara { font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem); }
      .cabecera { display: grid; gap: 1rem; }
      .cabecera--centro { justify-items: center; text-align: center; }
      .cabecera--centro .titular { max-width: 16ch; }
      .cabecera__sub { color: var(--gris); max-width: 34rem; }
      .seccion { padding-block: clamp(4.5rem, 3rem + 5vw, 8rem); }

      .etiqueta-marco { display: inline-block; padding: 0.25rem 0.5rem; background: rgb(0 0 0 / 0.35); border: 1px solid var(--rojo-texto); border-radius: 3px; color: var(--rojo-texto); font-size: 0.875rem; line-height: 1.3; }
      .etiqueta-marco--grande { font-size: 0.9375rem; }

      .pastilla { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--beige); color: var(--negro); font-size: 0.875rem; font-weight: 500; white-space: nowrap; }

      /* ---------- Menú ---------- */
      .menu { position: sticky; top: 0; z-index: 20; background: var(--negro-2); }
      .menu__barra { position: relative; display: flex; align-items: center; gap: 0.75rem; min-height: 72px; }
      .menu__nav { order: 3; }
      .menu__abrir { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--linea); border-radius: 999px; background: none; color: var(--crema); cursor: pointer; }
      .menu__enlaces { display: none; }
      .menu__enlaces.abierto { display: grid; position: absolute; top: 100%; left: 0; right: 0; padding: 0.5rem; border-radius: 0 0 14px 14px; background: var(--negro-2); border-top: 1px solid var(--linea); }
      .menu__enlaces a { display: flex; align-items: center; min-height: 52px; padding-inline: 1rem; color: var(--crema); text-decoration: none; font-family: var(--serif); font-weight: 600; font-size: 1.25rem; }
      .menu__enlaces a[aria-current='page'] { color: var(--rojo-texto); }
      .menu__cta { margin-left: auto; }
      @media (min-width: 60rem) {
        .menu__nav { order: 0; margin-left: auto; }
        .menu__abrir { display: none; }
        .menu__enlaces, .menu__enlaces.abierto { display: flex; position: static; padding: 0; background: none; border: 0; }
        .menu__enlaces a { min-height: 44px; padding-inline: 0.875rem; font-family: var(--sans); font-weight: 500; font-size: 0.9375rem; color: var(--gris); border-radius: 999px; }
        .menu__enlaces a:hover { color: var(--crema); }
        .menu__enlaces a[aria-current='page'] { color: var(--crema); box-shadow: inset 0 0 0 1px rgb(246 241 232 / 0.35); }
        .menu__cta { margin-left: 0.5rem; }
      }

      /* ---------- Hero ---------- */
      .hero { position: relative; isolation: isolate; display: grid; min-height: min(calc(100svh - 72px), 56rem); padding-block: 1.5rem 3rem; overflow: hidden; }
      .hero__foto { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 60% 25%; }
      .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.2) 60%, rgb(0 0 0 / 0.1)), linear-gradient(to bottom, transparent 30%, rgb(0 0 0 / 0.8)); }
      .hero__contenido { display: grid; grid-template-rows: auto 1fr; gap: 2rem; }
      .hero__ver { justify-self: start; display: inline-flex; align-items: center; gap: 0.625rem; padding: 0.5rem 1.125rem; border: 1px solid rgb(246 241 232 / 0.5); border-radius: 999px; background: rgb(0 0 0 / 0.2); font-size: 0.875rem; backdrop-filter: blur(6px); }
      .hero__abajo { align-self: end; display: grid; gap: 2.5rem; }
      .hero__cita { display: grid; gap: 1rem; }
      .hero__cita blockquote { font-family: var(--serif); font-weight: 600; font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.25rem); line-height: 1; letter-spacing: -0.025em; max-width: 14ch; }
      .hero__cita figcaption { display: grid; justify-items: start; gap: 0.625rem; }
      .hero__nombre { font-family: var(--serif); font-weight: 700; font-size: 1.625rem; letter-spacing: -0.02em; }
      .hero__detalle { display: inline-block; padding: 0.375rem 0.875rem; border-radius: 999px; background: var(--rojo); color: var(--crema); font-size: 1rem; font-weight: 600; }
      .hero__que { display: grid; justify-items: start; gap: 0.875rem; max-width: 36rem; padding-left: 1.25rem; border-left: 3px solid var(--rojo-texto); }
      .hero__que h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem); line-height: 1.12; letter-spacing: -0.015em; }
      .hero__que > p { color: rgb(246 241 232 / 0.88); font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem); line-height: 1.5; }
      .hero__accion { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 0.5rem; }
      .hero__accion span { font-size: 0.875rem; color: rgb(246 241 232 / 0.85); }
      @media (min-width: 64rem) { .hero__abajo { max-width: 40rem; gap: 2.25rem; } .hero__foto { object-position: 75% 25%; } }

      /* ---------- No eres el único ---------- */
      .unico .cabecera { margin-bottom: clamp(2.5rem, 2rem + 2vw, 4.5rem); }
      .unico__lista { display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 0.875rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margen); margin-inline: calc(-1 * var(--margen)); padding-inline: var(--margen); scrollbar-width: none; }
      .unico__lista::-webkit-scrollbar { display: none; }
      .unico__lista .tarjeta { scroll-snap-align: start; }
      .tarjeta { display: grid; grid-template-rows: auto 1fr; border-radius: 14px; overflow: hidden; background: var(--tarjeta); }
      .tarjeta__foto { width: 100%; aspect-ratio: 8 / 7; object-fit: cover; }
      .tarjeta__texto { display: grid; align-content: start; gap: 0.75rem; padding: 1.25rem 1.25rem 1.5rem; }
      .tarjeta__cita { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; line-height: 1.2; }
      .tarjeta__firma { color: var(--gris); font-size: 0.875rem; }
      @media (min-width: 40rem) { .unico__lista { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; overflow: visible; margin-inline: 0; padding-inline: 0; } }
      @media (min-width: 64rem) { .unico__lista { grid-template-columns: repeat(4, 1fr); } }

      /* ---------- ¿Qué es NextYou? ---------- */
      .que { background: var(--papel); color: var(--negro); }
      .que__cabecera { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); }
      .que__pregunta { font-family: var(--serif); font-weight: 600; font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem); line-height: 1; letter-spacing: -0.03em; }
      .que__cabecera h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(1.375rem, 1.15rem + 1vw, 2.125rem); line-height: 1.2; max-width: 32ch; text-wrap: balance; }
      .que__cabecera h2 em { color: var(--rojo-oscuro); font-weight: 600; }
      .demo { display: grid; gap: 2.5rem 1.5rem; }
      .demo__paso { display: grid; justify-items: start; align-content: start; gap: 0.5rem; }
      .demo__n { font-family: var(--serif); font-weight: 600; font-size: 3rem; line-height: 1; color: var(--rojo-oscuro); letter-spacing: -0.04em; margin-top: 1rem; }
      .demo__paso h3 { font-family: var(--serif); font-weight: 600; font-size: 1.375rem; line-height: 1.2; }
      .demo__paso > p { color: var(--gris-oscuro); }
      .pastilla--contorno { background: none; border: 1px solid var(--negro); }
      .pantalla { position: relative; width: 100%; min-height: 14rem; display: grid; align-content: start; gap: 0.5rem; padding: 1rem; border-radius: 16px; background: var(--negro); color: var(--crema); font-size: 0.875rem; overflow: hidden; box-shadow: 0 18px 32px -20px rgb(0 0 0 / 0.6); }
      .pantalla__titulo { font-family: var(--serif); font-weight: 600; font-size: 1.0625rem; line-height: 1.2; margin-bottom: 0.25rem; }
      .pantalla__tarea, .pantalla__camino { padding: 0.75rem; border-radius: 10px; background: var(--tarjeta); border: 1px solid var(--linea); font-weight: 600; }
      .pantalla__resp { display: grid; grid-template-columns: 1fr 1fr; gap: 0.375rem; margin-top: 0.25rem; }
      .pantalla__resp span { padding: 0.5rem; border-radius: 8px; border: 1px solid var(--linea); text-align: center; font-weight: 600; }
      .pantalla__resp span.sel { background: var(--rojo); border-color: var(--rojo); }
      .pantalla__camino { display: flex; align-items: center; gap: 0.625rem; }
      .pantalla__punto { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--gris); }
      .pantalla__punto.lleno { border-color: var(--rojo-texto); background: var(--rojo-texto); }
      .pantalla--foto { padding: 0; aspect-ratio: 4 / 5; max-height: 22rem; }
      .pantalla__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; }
      .pantalla--foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 45%, rgb(0 0 0 / 0.9)); }
      .pantalla__dur { position: absolute; z-index: 1; top: 0.75rem; left: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 999px; background: rgb(0 0 0 / 0.6); font-size: 0.8125rem; }
      .pantalla__pie { position: absolute; z-index: 1; left: 1rem; bottom: 0.875rem; display: grid; line-height: 1.3; }
      .pantalla__pie strong { font-family: var(--serif); font-size: 1.125rem; }
      .pantalla__burbuja { justify-self: start; max-width: 85%; padding: 0.625rem 0.75rem; border-radius: 14px 14px 14px 4px; background: var(--tarjeta); border: 1px solid var(--linea); }
      .pantalla__burbuja--tu { justify-self: end; border-radius: 14px 14px 4px 14px; background: var(--rojo); border-color: var(--rojo); font-weight: 600; }
      .pantalla__meta { color: var(--gris); font-size: 0.8125rem; }
      .que__pie { display: grid; justify-items: start; gap: 1.75rem; margin-top: clamp(3rem, 2rem + 3vw, 4.5rem); padding-top: 2rem; border-top: 1px solid rgb(0 0 0 / 0.15); }
      .nopasa { display: grid; gap: 0.75rem 2.5rem; font-weight: 600; }
      .nopasa li { display: flex; gap: 0.625rem; align-items: baseline; }
      .nopasa svg { flex-shrink: 0; color: var(--rojo-oscuro); translate: 0 1px; }
      @media (min-width: 48rem) {
        .demo { grid-template-columns: repeat(2, 1fr); }
        .nopasa { grid-template-columns: repeat(2, auto); }
      }
      @media (min-width: 64rem) {
        .demo { grid-template-columns: repeat(4, 1fr); }
        .pantalla { height: 17rem; }
        .pantalla--foto { aspect-ratio: auto; }
        .que__pie { grid-template-columns: 1fr auto; align-items: center; }
      }

      /* ---------- Los de dentro ---------- */
      .dentro { background: var(--negro-2); padding-bottom: clamp(4rem, 3rem + 4vw, 7rem); }
      .dentro__nav { display: flex; justify-content: flex-end; align-items: center; gap: 1rem; margin-block: 2rem 1.5rem; }
      .dentro__cuenta { color: var(--gris); font-size: 0.875rem; min-width: 3rem; text-align: center; }
      .flecha { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--crema); background: none; color: var(--crema); font-size: 1.25rem; cursor: pointer; }
      .flecha:disabled { border-color: var(--linea); color: rgb(246 241 232 / 0.3); cursor: default; }
      .reels { display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 24rem); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margen); padding-inline: var(--margen); scrollbar-width: none; }
      .reels::-webkit-scrollbar { display: none; }
      .reel { position: relative; aspect-ratio: 380 / 560; border-radius: 16px; overflow: hidden; scroll-snap-align: start; background: var(--tarjeta); }
      .reel__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .reel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 55%, rgb(0 0 0 / 0.85)); }
      .reel__dur { position: absolute; z-index: 1; top: 1rem; left: 1rem; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.6rem; border-radius: 999px; background: rgb(60 56 52 / 0.75); font-size: 0.8125rem; }
      .reel__pie { position: absolute; z-index: 1; left: 1.5rem; right: 1.5rem; bottom: 1.5rem; display: grid; justify-items: start; gap: 0.5rem; }
      .reel__nombre { font-family: var(--serif); font-weight: 700; font-size: 1.875rem; letter-spacing: -0.02em; line-height: 1; }
      .puntos { display: flex; gap: 0.5rem; margin-top: 2rem; }
      .puntos span { width: 6px; height: 6px; border-radius: 999px; background: rgb(246 241 232 / 0.3); transition: width 200ms ease; }
      .puntos span.activo { width: 24px; background: var(--rojo-texto); }

      /* ---------- Sara ---------- */
      .sara { background: var(--negro); color: var(--crema); padding-block: clamp(4.5rem, 3rem + 5vw, 7rem); border-top: 1px solid var(--linea); }
      .sara__rejilla { display: grid; gap: 3rem; align-items: center; }
      .sara__texto { display: grid; justify-items: start; gap: 1.25rem; }
      .sara__texto > p:not([class]) { color: rgb(246 241 232 / 0.82); max-width: 33rem; line-height: 1.7; }
      .firma { font-family: var(--mano); font-size: 2.25rem; color: var(--rojo-texto); line-height: 1; margin-block: 0.75rem 0.5rem; }
      .sara__foto { position: relative; aspect-ratio: 536 / 480; border-radius: 16px; overflow: hidden; background: radial-gradient(120% 90% at 30% 20%, #2a231e, var(--tarjeta) 70%); border: 1px dashed rgb(246 241 232 / 0.22); display: flex; align-items: end; }
      .sara__aviso { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.625rem; color: var(--gris); font-size: 0.875rem; }
      .sara__foto p { position: relative; width: 100%; display: grid; padding: 3rem 1.25rem 1.25rem; background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.7)); color: var(--crema); font-size: 0.8125rem; }
      .sara__foto strong { font-family: var(--serif); font-weight: 700; font-size: 1.25rem; }
      @media (min-width: 56rem) { .sara__rejilla { grid-template-columns: 1fr 1.05fr; gap: 5rem; } }

      /* ---------- Pie ---------- */
      .pie { background: var(--negro-2); padding-block: 4rem 5rem; }
      .pie__arriba { display: grid; gap: 1.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--linea); }
      .pie ul { display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; }
      .pie ul a { color: var(--gris); font-size: 0.875rem; text-decoration: none; display: inline-block; padding-block: 0.6rem; }
      .pie ul a:hover { color: var(--crema); }
      .pie__lema { font-family: var(--serif); font-weight: 600; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem); line-height: 1.05; letter-spacing: -0.025em; margin-top: 3rem; }
      @media (min-width: 56rem) { .pie__arriba { grid-template-columns: auto 1fr; align-items: center; } .pie nav { justify-self: end; } }
    </style>
  </body>
