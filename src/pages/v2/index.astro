      .reel__nombre { font-family: var(--serif); font-weight: 700; font-size: 1.875rem; letter-spacing: -0.02em; line-height: 1; }
      .puntos { display: flex; gap: 0.5rem; margin-top: 2rem; }
      .puntos span { width: 6px; height: 6px; border-radius: 999px; background: rgb(246 241 232 / 0.3); transition: width 200ms ease; }
      .puntos span.activo { width: 24px; background: var(--rojo-texto); }

      /* ---------- Cómo funciona ---------- */
      .como .cabecera { margin-bottom: 3.5rem; }
      .paso { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.25rem; align-items: start; padding-block: 2.25rem; border-top: 1px solid var(--linea); }
      .paso:last-child { border-bottom: 1px solid var(--linea); }
      .paso__n { grid-row: span 2; font-family: var(--serif); font-weight: 600; font-size: clamp(3.5rem, 2.4rem + 4vw, 6rem); line-height: 0.85; color: var(--rojo-texto); letter-spacing: -0.04em; font-variation-settings: 'opsz' 144; min-width: 1.6em; }
      .paso h3 { font-family: var(--serif); font-weight: 600; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); line-height: 1.2; margin-bottom: 0.5rem; }
