      /* ---------- Sara ---------- */
      .sara { background: var(--beige); color: var(--negro); padding-block: clamp(4.5rem, 3rem + 5vw, 7rem); }
      .sara__rejilla { display: grid; gap: 3rem; align-items: center; }
